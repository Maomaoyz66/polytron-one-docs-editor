PRODUCTION_DOCS_URL=https://polytron-one-docs.vercel.app/docs

# Used by the deployed Vercel API to write edited docs back to GitHub.
GITHUB_TOKEN=
GITHUB_REPO=Maomaoyz66/polytron-one-docs-editor
GITHUB_BRANCH=main
EDITOR_PASSWORD=
EDITOR_SESSION_SECRET=

# Use one of these when you connect production publishing:
# 1) A production API that accepts the same publish payload as the local server.
REMOTE_PUBLISH_ENDPOINT=

# 2) A Vercel Deploy Hook URL for the existing polytron-doc project.
# Note: this only triggers a Vercel rebuild from that project's connected source.
VERCEL_DEPLOY_HOOK_URL=

# Editor default publish endpoint for local development.
# The deployed editor ignores localhost endpoints and uses its own /api/publish-docs route.
VITE_PUBLISH_ENDPOINT=http://127.0.0.1:8787/api/publish-docs
